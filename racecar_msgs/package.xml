<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>racecar_msgs</name>
  <version>0.0.1</version>
  <description>Packages for Custom msgs</description>
  <maintainer email="cn1182@princeton.edu">ece346-15</maintainer>
  <license>Apache - 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- No Python Packages -->
  <!-- <buildtool_depend>ament_cmake_python</buildtool_depend> -->
  
  
  <!-- dependency on generating .srv msgs etc -->
  <buildtool_depend>rosidl_default_generators</buildtool_depend>


  

  <!-- ROS 2 message dependencies -->
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>


  <!-- runtime dependencies for the custom msgs -->
  <exec_depend>rosidl_default_runtime</exec_depend>


  <!--package is registered as aprt of rosidl interface packages -->
  <!--Allows other packages to use this packages custom msgs -->
  <member_of_group>rosidl_interface_packages</member_of_group>


  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
